olumn":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"parceiros de brainstorming e co-criação","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"DRu4XXDybR"}],"key":"UJKWuYi9SG"},{"type":"text","value":" no processo de formulação de problemas de SBSE.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"YMZTuzwtT9"}],"key":"NTxLkhF437"},{"type":"heading","depth":3,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"2.1. O LLM como um “Oráculo de Métricas”","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"vOObJV85ej"}],"identifier":"id-2-1-o-llm-como-um-or-culo-de-m-tricas","label":"2.1. O LLM como um “Oráculo de Métricas”","html_id":"id-2-1-o-llm-como-um-or-culo-de-m-tricas","implicit":true,"key":"laepLm4tVW"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"O maior desafio ao aplicar SBSE é definir a função de fitness. Uma boa função de fitness é a bússola que guia a busca para soluções de alta qualidade. Uma função mal definida pode levar a otimizações inúteis ou até prejudiciais (Lei de Goodhart).","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"IOKI5vENon"}],"key":"WerxRwVkqm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":44,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Técnica: Persona Prompting","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"Jn1zTmfPug"}],"key":"J72akJuN6Z"}],"key":"LdAtZRlZsG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":45,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"O que é?","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"GzGA1QQGvt"}],"key":"mOfJdt9rQa"},{"type":"text","value":" É uma técnica de engenharia de prompt onde instruímos o LLM a assumir uma persona específica (ex: “Aja como um Arquiteto de Software Sênior da Google...”, “Você é um especialista em logística...”).","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"JTdst9DDAa"}],"key":"NwCamXSb5m"}],"key":"alogGAN3jQ"},{"type":"listItem","spread":true,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Por que funciona?","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"pvP1boeoYl"}],"key":"RGxnqakKOP"},{"type":"text","value":" Ao assumir uma persona, o LLM ativa as partes de seu modelo de conhecimento mais relevantes para aquele domínio, fornecendo respostas mais focadas, detalhadas e com o jargão correto.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"YFbQHBYbC7"}],"key":"tHhjJq94xM"}],"key":"zG1yg0dCGv"},{"type":"listItem","spread":true,"position":{"start":{"line":47,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Aplicação em SBSE:","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"WdF4jIpKqc"}],"key":"NI0V2wZuqz"},{"type":"text","value":" Usamos essa técnica para traduzir um requisito vago em métricas.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"lWPgAV6lxl"}],"key":"rz0FbUElXJ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":48,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Prompt Vago:","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"DUHeWBxT0m"}],"key":"fe0wCdPHJS"},{"type":"text","value":" “Como melhorar a manutenibilidade do código?”","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"rWtzaXG3Oq"}],"key":"f4MhfTz1SS"}],"key":"qVAUR2w5Ut"},{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Prompt com Persona:","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"ESwKcu2viR"}],"key":"WQ4EBVlZQi"},{"type":"text","value":" “Aja como um engenheiro de software especialista em qualidade de código. Dado o requisito de ‘melhorar a manutenibilidade de um sistema orientado a objetos’, sugira 5 métricas de software concretas e quantificáveis que poderiam ser combinadas em uma função de fitness. Para cada métrica, explique o que ela mede e por que é importante.”","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"W0gVHSaIR4"}],"key":"uNTUKIfPwE"}],"key":"iGjWEA07XF"}],"key":"rUKvyAg48z"}],"key":"xejR0BOsML"}],"key":"RAa1Y1CdJ4"}],"key":"EK35vKbGwq"}],"key":"je9FLQtYIC"},{"type":"heading","depth":3,"position